# Nexora OS kernel configuration fragment, merged on top of the
# upstream x86_64_defconfig (Linux 6.12 LTS).

# Loadable modules: GPU drivers are modules so that their firmware is
# loaded from the root filesystem (eudev loads them via modalias).
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_FW_LOADER=y

# Boot: GRUB loads /boot/bzImage from the root slot; EFI stub kept.
# GPT (root=PARTUUID=), root on SATA/NVMe/virtio/USB, ext4, vfat (ESP)
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
# vfat mount of the ESP (/boot/efi, grubenv): default codepage/iocharset
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_INOTIFY_USER=y

# Consoles: serial (recovery) and VT/framebuffer console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# DRM/KMS
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_BOCHS=m

# Input: evdev, USB HID, game controllers
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MICROSOFT=m
CONFIG_HID_SONY=m
CONFIG_SONY_FF=y
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y
# The remaining USB controllers of docs/linux_gamepad_drivers.md. All are
# modules: eudev loads them by modalias when a controller is plugged in, and
# the HID core then rebinds the device from hid-generic to the specific driver.
# /dev/input/js* (joydev) for emulators that still use the joystick API
CONFIG_INPUT_JOYDEV=m
# Steam Controller (USB / wireless dongle), Steam Deck
CONFIG_HID_STEAM=m
CONFIG_STEAM_FF=y
# Logitech pads (Dual Action, RumblePad 2, F310/F510/F710 in D mode), wheels
# (G29 via lg4ff, G920/G923 via HID++) and flight sticks
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_LOGITECH_FF=y
CONFIG_LOGIRUMBLEPAD2_FF=y
CONFIG_LOGIG940_FF=y
CONFIG_LOGIWHEELS_FF=y
# Thrustmaster wheels, HOTAS and sticks
CONFIG_HID_THRUSTMASTER=m
CONFIG_THRUSTMASTER_FF=y
# Generic USB pads: DragonRise ("USB Gamepad", 0079:xxxx), GreenAsia,
# SmartJoy PLUS / PS2 USB adapters, PantherLord, Zeroplus, Betop
CONFIG_HID_DRAGONRISE=m
CONFIG_DRAGONRISE_FF=y
CONFIG_HID_GREENASIA=m
CONFIG_GREENASIA_FF=y
CONFIG_HID_SMARTJOYPLUS=m
CONFIG_SMARTJOYPLUS_FF=y
CONFIG_HID_PANTHERLORD=m
CONFIG_PANTHERLORD_FF=y
CONFIG_HID_ZEROPLUS=m
CONFIG_ZEROPLUS_FF=y
CONFIG_HID_BETOP_FF=m
# Google Stadia controller (USB), Mayflash GameCube adapter
CONFIG_HID_GOOGLE_STADIA_FF=m
CONFIG_HID_MAYFLASH=m
# QEMU virtio-input: lets a test VM receive a (virtual) controller from the
# host with virtio-input-host-pci, see docs/controller-support.md
CONFIG_VIRTIO_INPUT=m
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y

# USB host controllers and storage (boot from USB stick)
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# Sound (optional for the UI, needed by emulators)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_USB_AUDIO=m
