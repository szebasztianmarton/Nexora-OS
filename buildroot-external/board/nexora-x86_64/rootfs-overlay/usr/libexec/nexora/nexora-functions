# shellcheck shell=sh
# Shared helpers for the Nexora OS A/B slot scripts (nexora-updated,
# nexora-bootok, nexora-recovery, S01nexora-data). Sourced, never executed.
# Written for BusyBox sh (no bashisms).
#
# Disk layout (see board/nexora-x86_64/genimage.cfg), GPT partition names:
#   nexora-esp    vfat, GRUB + grub.cfg + grubenv, mounted at /boot/efi
#   nexora-rootA  ext4 root filesystem, slot A (kernel at /boot/bzImage)
#   nexora-rootB  ext4 root filesystem, slot B
#   nexora-data   ext4 user data, mounted at /home
#
# grubenv variables (read by grub.cfg, written here with grub-editenv):
#   nexora_slot   A|B     confirmed (known good) slot
#   nexora_try    A|B|""  newly installed slot on trial ("" = none)
#   nexora_tries  0..3    trial boots left; grub.cfg decrements it

NEXORA_ESP_MOUNT=/boot/efi
NEXORA_GRUBENV="${NEXORA_ESP_MOUNT}/EFI/BOOT/grubenv"
# Written by nexora-updated after arming a trial boot, consumed by
# nexora-bootok. On the ESP (root-only mount), not in the user's home.
# shellcheck disable=SC2034 # used by the scripts that source this file
NEXORA_PENDING_FILE="${NEXORA_ESP_MOUNT}/nexora/update-pending"
NEXORA_RELEASE_FILE=/etc/nexora-release
NEXORA_CMDLINE_FILE=/proc/cmdline
NEXORA_GRUB_EDITENV=grub-editenv

# Prints A or B (the slot GRUB booted, from nexora.slot= on the kernel
# command line); fails if absent.
nexora_running_slot() {
	_slot=$(tr ' ' '\n' < "${NEXORA_CMDLINE_FILE}" |
		sed -n 's/^nexora\.slot=\([AB]\)$/\1/p' | tail -n 1)
	[ -n "${_slot}" ] || return 1
	echo "${_slot}"
}

nexora_other_slot() {
	case "$1" in
	A) echo B ;;
	B) echo A ;;
	*) return 1 ;;
	esac
}

# nexora_release_value KEY: value of KEY in /etc/nexora-release (quotes
# removed). KEY must be a fixed word chosen by the caller.
nexora_release_value() {
	sed -n "s/^$1=//p" "${NEXORA_RELEASE_FILE}" 2> /dev/null |
		tail -n 1 | tr -d '"'
}

# nexora_safe_word VALUE: prints VALUE if it only contains
# [A-Za-z0-9._+-] (1..64 characters), else "unknown". Used for every value
# that is written into a record or a JSON file.
nexora_safe_word() {
	case "$1" in
	"" | *[!A-Za-z0-9._+-]*)
		echo unknown
		return 0
		;;
	esac
	if [ "${#1}" -gt 64 ]; then
		echo unknown
	else
		echo "$1"
	fi
}

# nexora_env_get NAME: value of a grubenv variable (empty if unset).
nexora_env_get() {
	"${NEXORA_GRUB_EDITENV}" "${NEXORA_GRUBENV}" list 2> /dev/null |
		sed -n "s/^$1=//p" | tail -n 1
}

# nexora_env_set NAME=VALUE...: update grubenv and flush it to disk.
nexora_env_set() {
	"${NEXORA_GRUB_EDITENV}" "${NEXORA_GRUBENV}" set "$@" || return 1
	sync
}

# nexora_part_device NAME: /dev node of the GPT partition called NAME on
# the disk that holds the running root filesystem. Works before udev has
# run (uses sysfs and devtmpfs only). Fails if not exactly one matches.
nexora_part_device() {
	_majmin=$(mountpoint -d /) || return 1
	_sys=$(readlink -f "/sys/dev/block/${_majmin}") || return 1
	_disk=${_sys%/*}
	_found=""
	for _uevent in "${_disk}"/*/uevent; do
		[ -f "${_uevent}" ] || continue
		grep -qx "PARTNAME=$1" "${_uevent}" || continue
		[ -z "${_found}" ] || return 1
		_found=/dev/$(sed -n 's/^DEVNAME=//p' "${_uevent}")
	done
	[ "${_found}" != "" ] && [ "${_found}" != "/dev/" ] || return 1
	echo "${_found}"
}

# nexora_size PATH: size in bytes of a block device or a regular file.
nexora_size() {
	if [ -b "$1" ]; then
		_name=$(readlink -f "$1") || return 1
		_name=${_name##*/}
		_sectors=$(cat "/sys/class/block/${_name}/size") || return 1
		echo $((_sectors * 512))
	elif [ -f "$1" ]; then
		# Regular files only occur in nexora-updated's test mode.
		echo $(($(wc -c < "$1")))
	else
		return 1
	fi
}
