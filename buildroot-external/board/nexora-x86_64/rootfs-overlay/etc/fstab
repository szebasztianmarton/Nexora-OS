# <file system>	<mount pt>	<type>	<options>	<dump>	<pass>
/dev/root	/		ext2	rw,noauto	0	1
proc		/proc		proc	defaults	0	0
devpts		/dev/pts	devpts	defaults,gid=5,mode=620,ptmxmode=0666	0	0
tmpfs		/dev/shm	tmpfs	mode=1777	0	0
tmpfs		/tmp		tmpfs	mode=1777	0	0
tmpfs		/run		tmpfs	mode=0755,nosuid,nodev	0	0
sysfs		/sys		sysfs	defaults	0	0
# Nexora OS persistent partitions. "noauto": they are mounted by
# /etc/init.d/S01nexora-data, which finds them by GPT partition name before
# udev runs (BusyBox mount has no LABEL= support and "mount -a" runs before
# /dev/disk/by-* exists), checks the data filesystem with "e2fsck -p" and
# never blocks the boot for more than 10 s. These lines document the layout
# and allow "mount /home" / "mount /boot/efi" by hand once udev is up.
/dev/disk/by-partlabel/nexora-data	/home	ext4	noauto,noatime	0	0
/dev/disk/by-partlabel/nexora-esp	/boot/efi	vfat	noauto,noatime,umask=0077,flush	0	0
